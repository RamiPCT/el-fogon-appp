# Copia este archivo como ".env" y rellena los valores.
# En Railway/Render, crea estas mismas variables en el panel del servicio.

# PIN del personal para entrar al KDS y al panel de administración (obligatorio en producción).
# Usa al menos 6 dígitos y no lo compartas con clientes.
STAFF_PIN=

# Pon "production" al publicar la web.
NODE_ENV=development

# Puerto (Railway/Render lo asignan solos; en local, 3001).
PORT=3001

# URL pública definitiva, sin barra final (para los enlaces de cancelación y SEO).
# Ej.: https://elfogon.es
PUBLIC_URL=

# Carpeta donde se guarda la base de datos. En Railway/Render apúntala a un volumen persistente (ej.: /data).
DATA_DIR=
